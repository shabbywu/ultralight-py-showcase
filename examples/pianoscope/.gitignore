.pytest_cache/
*.egg-info/
build/
dist/

# Local inputs and development output belong in ../../.tmp/pianoscope/.
/*.[mM][iI][dD]
/*.[mM][iI][dD][iI]

# Public docs contain only licenses and explicitly selected guide resources.
# Plans, stage notes, validation reports and debug artifacts stay local.
